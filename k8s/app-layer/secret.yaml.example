---
# Secret for short link service — MySQL password
#
# Usage:
#   1. Copy to secret.yaml:  cp secret.yaml.example secret.yaml
#   2. Replace CHANGE_ME with the real MySQL password (same as mysql-credentials/shortlink-password)
#   3. Apply:  kubectl apply -f secret.yaml
#
# Or create directly (recommended — no file with real password on disk):
#   kubectl create secret generic shortlink-secrets \
#     --namespace=app-layer \
#     --from-literal=MYSQL_PASSWORD='CHANGE_ME'
#
# secret.yaml is .gitignored — never commit real passwords.
---
apiVersion: v1
kind: Secret
metadata:
  name: shortlink-secrets
  namespace: app-layer
  labels:
    app.kubernetes.io/part-of: shortlink-cluster
type: Opaque
stringData:
  MYSQL_PASSWORD: "CHANGE_ME"
