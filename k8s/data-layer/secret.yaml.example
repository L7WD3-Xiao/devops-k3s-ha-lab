---
# MySQL credentials Secret for ProxySQL + Orchestrator
#
# Usage:
#   1. Copy to secret.yaml:  cp secret.yaml.example secret.yaml
#   2. Replace CHANGE_ME with real passwords
#   3. Apply:  kubectl apply -f secret.yaml
#
# Or create directly (recommended — no file with real passwords on disk):
#   kubectl create secret generic mysql-credentials \
#     --namespace=data-layer \
#     --from-literal=monitor-password='CHANGE_ME' \
#     --from-literal=shortlink-password='CHANGE_ME' \
#     --from-literal=orchestrator-password='CHANGE_ME'
#
# secret.yaml is .gitignored — never commit real passwords.
---
apiVersion: v1
kind: Secret
metadata:
  name: mysql-credentials
  namespace: data-layer
  labels:
    app.kubernetes.io/part-of: mysql-ha
type: Opaque
stringData:
  monitor-password: "CHANGE_ME"
  shortlink-password: "CHANGE_ME"
  orchestrator-password: "CHANGE_ME"
  proxysql-admin-password: "CHANGE_ME"
  proxysql-radmin-password: "CHANGE_ME"
