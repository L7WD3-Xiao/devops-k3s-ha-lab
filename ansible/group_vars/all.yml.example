---
# Global variables for K3s 3-Server HA cluster (Alibaba Cloud ECS)
#
# This is a SANITIZED template — copy to all.yml and fill in real values.
#   cp group_vars/all.yml.example group_vars/all.yml
#   vim group_vars/all.yml
#
# all.yml is gitignored and NOT tracked in version control.

# Node IP mapping (VPC 192.168.1.0/24)
node_ips:
  node-01: 192.168.1.228
  node-02: 192.168.1.230
  node-03: 192.168.1.229

# /etc/hosts entries
cluster_hosts:
  - { ip: "192.168.1.228", hostname: "node-01" }
  - { ip: "192.168.1.230", hostname: "node-02" }
  - { ip: "192.168.1.229", hostname: "node-03" }

# Base packages (dnf, RHEL / Alibaba Cloud Linux 3)
base_packages:
  - curl
  - wget
  - vim
  - git
  - net-tools
  - iproute
  - chrony
  - python3
  - python3-pip
  - gnupg
  - ca-certificates
  - tar
  - gzip

# Sysctl parameters for K3s
sysctl_k3s_config:
  - { key: "net.ipv4.ip_forward", value: 1 }
  - { key: "net.bridge.bridge-nf-call-iptables", value: 1 }
  - { key: "net.bridge.bridge-nf-call-ip6tables", value: 1 }

# Timezone
timezone: Asia/Shanghai

# Ops user (created by cloud-init, playbook verifies/supplements)
ops_user: ops

# ── K3s Configuration ─────────────────────────────────────────
# Version: empty = latest stable. Pin for reproducibility (e.g. "v1.30.5+k3s1")
k3s_version: ""

# First server node (cluster-init)
k3s_first_server: node-01
k3s_first_server_ip: "{{ node_ips['node-01'] }}"

# K3s API server port
k3s_api_port: 6443

# Flannel network interface (ECS uses eth0)
k3s_flannel_iface: eth0

# K3s directories
k3s_config_dir: /etc/rancher/k3s
k3s_data_dir: /var/lib/rancher/k3s

# External EIP on node-01 (for kubectl access from outside VPC)
k3s_external_ip: <集群公网入口IP>

# ── MySQL Configuration ──────────────────────────────────────
mysql_version: "8.0.46"
mysql_root_password: "CHANGE_ME"           # ← MySQL root 密码
mysql_repl_user: "repl"
mysql_repl_password: "CHANGE_ME"           # ← MySQL 复制用户密码
mysql_repl_allowed_host: "192.168.1.%"

mysql_app_db: "shortlink"
mysql_app_user: "shortlink"
mysql_app_password: "CHANGE_ME"            # ← 短链应用数据库密码

mysql_master_ip: "192.168.1.230"
mysql_slave_ip: "192.168.1.229"

mysql_innodb_buffer_pool_size: "256M"
mysql_max_connections: 100

mysql_rpm_dir: "/tmp/mysql-rpms"

# ── Alibaba Cloud ACR (Personal Edition — New, post 2024-09-09) ──
# Region: cn-hangzhou (same as ECS, VPC pull is free)
#
# New Personal Edition uses crpi- exclusive domains (not registry-):
#   VPC domain:   crpi-{id}-vpc.{region}.personal.cr.aliyuncs.com (K3s pull, free)
#   Public domain: crpi-{id}.{region}.personal.cr.aliyuncs.com    (local push)
#
# IMPORTANT: New Personal Edition does NOT support pulling via public domain.
# K3s MUST use the VPC domain. Local docker push uses the public domain.
acr_registry: "crpi-vvz6iv4av6k8awep-vpc.cn-hangzhou.personal.cr.aliyuncs.com"
acr_registry_public: "crpi-vvz6iv4av6k8awep.cn-hangzhou.personal.cr.aliyuncs.com"
acr_namespace: "shortlink123"
acr_repository: "shortlink-app"
acr_username: "CHANGE_ME"                 # ← 阿里云账号或 RAM 子账号
acr_password: "CHANGE_ME"                 # ← ACR 控制台设置的固定密码
